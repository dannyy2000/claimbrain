# Somnia RPC
SOMNIA_RPC_URL=https://api.infra.mainnet.somnia.network
SOMNIA_TESTNET_RPC_URL=https://dream-rpc.somnia.network

# Deployer wallet — never commit the real key, put it in .env only
PRIVATE_KEY=your_deployer_wallet_private_key

# External API keys
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
DEFILLAMA_API_URL=https://api.llama.fi

# Deployed contract addresses — filled in after running: npm run deploy:testnet
POLICY_BRAIN_ADDRESS=
CLAIM_REGISTRY_ADDRESS=
INSURANCE_POOL_ADDRESS=
CLAIM_BRAIN_ADDRESS=
MONITORING_CONTRACT_ADDRESS=

# Keeper bot — comma-separated flight codes to watch
WATCHED_FLIGHTS=AA123,BA456
